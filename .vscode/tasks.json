{
  // Terminal → Ejecutar tarea… (o Ctrl+Shift+P → «Tasks: Run Task»).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Ver el sitio en local (npm run dev)",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "group": { "kind": "build", "isDefault": true }
    },
    { "label": "✔ Revisar el código (lint)", "type": "npm", "script": "lint", "problemMatcher": ["$eslint-stylish"] },
    { "label": "🏗 Compilar como en producción (build)", "type": "npm", "script": "build", "problemMatcher": [] },
    { "label": "🗄 Aplicar cambios de la base de datos (db:push)", "type": "npm", "script": "db:push", "problemMatcher": [] },
    {
      "label": "✉ Probar el correo SMTP",
      "type": "shell",
      "command": "node scripts/probar-smtp.mjs",
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "focus": true }
    },
    {
      "label": "🌍 Abrir devmart.co",
      "type": "shell",
      "command": "start https://devmart.co",
      "windows": { "command": "start https://devmart.co" },
      "osx": { "command": "open https://devmart.co" },
      "linux": { "command": "xdg-open https://devmart.co" },
      "problemMatcher": []
    }
  ]
}
